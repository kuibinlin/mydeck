# ─────────────────────────────────────────────────────────────────────────────
# wrangler.toml — Cloudflare Worker configuration
#
# Deploy with:
#   npx wrangler deploy
#
# That single command reads this file and deploys the worker with all bindings.
#
# Sections in this file:
#   name             — Worker name registered in Cloudflare dashboard
#   main             — Entry point bundled and uploaded as the Worker script
#   compatibility_date — Locks the Workers runtime API version
#   [[d1_databases]] — Binds env.DB → D1 SQLite database (users, decks, cards)
#   [[kv_namespaces]] — Binds env.SESSIONS → KV store (sessions, magic links)
#   [observability]  — Enables request logging in the Cloudflare dashboard
#   [vars]           — Non-secret env vars (FRONTEND_URL, FROM_EMAIL)
#   [[routes]]       — Custom domain routing (optional, requires your domain on Cloudflare)
# ─────────────────────────────────────────────────────────────────────────────

### Worker name — must match the name in your Cloudflare dashboard.
name = "mydeck-api"

### Entry point for the worker.
main = "src/index.js"

### Locks the Workers runtime API to a specific date so behaviour
### doesn't change when Cloudflare ships breaking runtime updates.
### Update this intentionally, not automatically.
compatibility_date = "2026-03-24"

### D1 (SQLite) database — stores users, decks, cards, scores.
### Find the database_id in: Cloudflare dashboard → D1 → mydeck-db
### binding = how the worker code accesses it (env.DB) — changing this breaks all env.DB calls.
### database_name = the actual D1 database name in your Cloudflare account.
[[d1_databases]]
binding = "DB"
database_name = "mydeck-db"
database_id = "xxxxxxxxxxx"

### KV namespace — stores sessions and magic link tokens.
### Find the id in: Cloudflare dashboard → KV → mydeck-sessions
### binding = how the worker code accesses it (env.SESSIONS) — changing this breaks all env.SESSIONS calls.
[[kv_namespaces]]
binding = "SESSIONS"
id = "xxxxxxxxxxx"

### Optional — HSK vocabulary server, bound worker-to-worker.
### Only needed for the Chinese tutor tab. `service` is the Worker's name in
### your Cloudflare account, not its domain. A service binding carries no client
### IP, so it bypasses the public endpoint's per-IP rate limit.
### Without it, integrations/hskMcp.js falls back to the public HTTPS endpoint.
# [[services]]
# binding = "HSK"
# service = "hsk-mcp"

### Enables request logging and tracing in the Cloudflare dashboard.
[observability]
enabled = true

### Non-secret environment variables — safe to commit.
### Secrets (API keys, OAuth credentials) must never go here.
### Set them once via CLI: npx wrangler secret put <KEY>
###   - RESEND_API_KEY
###   - GITHUB_CLIENT_ID
###   - GITHUB_CLIENT_SECRET
###   - AI_API_KEY              only when AI_DEFAULT_PROVIDER is not "cloudflare"
### For local dev, put secrets in .dev.vars (gitignored).
[vars]
FRONTEND_URL = "https://xxxxxxxx.com"
FROM_EMAIL = "noreply@sendme.dev"
ADMIN_EMAILS = "admin@gmail.com"  # comma-separated for multiple admins
AI_MAX_RETRIES = "3"
AI_DAILY_LIMIT_FREE = "60"   # counted per model call, and one tutor turn can spend 1-4
MAX_CARDS_PER_DECK = "50"       # max flashcards per deck
MAX_QUESTIONS_PER_DECK = "50"   # max questions per challenge deck

### APP_VERSION is deliberately NOT set here.
###
### GET /version reports it, so its whole value is being accurate about which
### build is live — and a version written into a committed config file is stale
### the first time someone forgets to bump it. Inject it at deploy time from the
### commit that produced the build instead:
###
###   npx wrangler deploy --var APP_VERSION:$(git rev-parse --short HEAD)
###
### Unset, /version reports "development", which is what tells a post-deploy
### smoke test that it is talking to a laptop and not to production.

### TWO models, because no single model does both jobs well:
###
###   AI_MODEL        flashcard and quiz generation. Wants clean JSON, fast. A
###                   reasoning model is the wrong choice here — it spends most of
###                   its output thinking before the JSON appears.
###
###   There is no AI_TUTOR_MODEL. The tutor runs in services/agent-service and
###   picks its model from that container's own AI_TUTOR_MODEL — this Worker has
###   not chosen the tutor's model since §11 step 9 deleted its loop.
###
### Check both before trusting a new model. A model that cannot do tools does not
### always say so — one accepted the tool list and then answered from memory,
### which reads as a working reply while every fact in it skipped the dictionary.

### Cloudflare Workers AI — via the env.AI binding, no API key needed.
### Free tier is 10,000 neurons/day ACCOUNT-WIDE (not per user). A tutor call is
### ~45 neurons and a turn spends 1-4, so plan on 50-200 turns/day before 4006.
AI_DEFAULT_PROVIDER = "cloudflare"
AI_MODEL = "@cf/aisingapore/gemma-sea-lion-v4-27b-it"

### SEA-LION (AI Singapore) — OpenAI-compatible, so the provider stays "openai".
### AI_BASE_URL is the host only; the code appends /v1/chat/completions.
### Needs AI_API_KEY.
# AI_DEFAULT_PROVIDER = "openai"
# AI_BASE_URL = "https://api.sea-lion.ai"
# AI_MODEL = "aisingapore/Gemma-SEA-LION-v4-27B-IT"
### The tutor's model is set on the agent service, not here. Avoid reasoning
### models for it (SEA-LION's v4.5, anything "-R") — four steps of visible
### thinking measured ~200s per turn, against a 20s deadline.

### Groq — also OpenAI-compatible. Needs AI_API_KEY.
# AI_DEFAULT_PROVIDER = "groq"
# AI_BASE_URL = "https://api.groq.com/openai"
# AI_MODEL = "llama-3.3-70b-versatile"

### Tested Cloudflare models
    # "@cf/nvidia/nemotron-3-120b-a12b"
    # "@cf/meta/llama-3.3-70b-instruct-fp8-fast"   tools: yes
    # "@cf/qwen/qwq-32b"
    # "@cf/meta/llama-4-scout-17b-16e-instruct"
    # "@cf/aisingapore/gemma-sea-lion-v4-27b-it"   tools: NO (rejects, 3030/8001)


### The Python agent service — services/agent-service, on Cloud Run.
### See docs/architecture.md §7 for the boundary and §11 for how it got here.
###
### This is the ONLY tutor. §11 step 9 deleted the Worker's own agent loop, so
### there are no flags: AGENT_ENABLED, AGENT_SHADOW and AGENT_ALLOWED_USERS all
### existed to choose between two implementations and went with the second one.
###
### UNSET IS A SUPPORTED STATE. No URL means no tutor, and routes/zh.js answers
### with the word cards alone — resolved deterministically from the bundled
### dictionary, no model and no network. That is what makes `wrangler dev`
### useful without a container running, and it is the same floor every failure
### of this hop lands on.
# AGENT_SERVICE_URL = "http://localhost:8080"   ### the Cloud Run URL in production
# AGENT_SERVICE_TIMEOUT_MS = "25000"
### Bounded well inside the client-facing request on purpose. The tutor is
### enrichment — routes/zh.js degrades to the cards — so a timeout here costs the
### prose, while letting Cloudflare's edge cut the connection costs the answer.
###
### PAIRED WITH AGENT_DEADLINE_S in the agent service, which must be LOWER (20s
### by default). The agent stops itself just before this fires; without that it
### keeps working after the Worker has stopped listening, spending model budget
### on a request nobody will read and holding a Cloud Run instance.

### AGENT_SERVICE_SECRET is a secret, not a var — see line 61:
###   npx wrangler secret put AGENT_SERVICE_SECRET
### The same value goes into Google Secret Manager. The service refuses to serve
### on Cloud Run without it, so a missing secret fails loudly rather than leaving
### public ingress open.


### Custom domain — routes your API subdomain to this worker.
### Requires your domain to be on Cloudflare.
# [[routes]]
# pattern = "mydeckapi.yourdomain.com/*"
# zone_name = "yourdomain.com"

# Workers AI binding — gives the worker access to env.AI for LLM inference.
# Model selection happens at runtime in code, not here.
[ai]
binding = "AI"

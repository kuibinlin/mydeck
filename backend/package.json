{
  "name": "mydeck-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local-upstream 127.0.0.1",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "wrangler d1 execute linsnotes-db --file=schema.sql",
    "db:init:local": "wrangler d1 execute linsnotes-db --local --file=schema.sql",
    "db:migrate": "wrangler d1 migrations apply linsnotes-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply linsnotes-db --local",
    "db:migrate:list": "wrangler d1 migrations list linsnotes-db --remote",
    "hsk:index": "node scripts/build-hsk-index.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.80.0"
  }
}

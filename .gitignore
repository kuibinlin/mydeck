# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# env files
.env
.env*.local

# claude
CLAUDE.md
.claude/

# personal notes (not for commit)
notes/

# data files
data/

# ...except generated source data that the build depends on. Both are produced
# by a script and both are bundled: hsk-core.json IS the offline dictionary tier
# the tutor falls back to, and without it the Worker does not build. A fresh
# clone must have them.
!backend/src/services/zh/data/
!frontend/src/features/chinese/data/

# generated sql seed files
sql-flashcards-*.sql
sql-challenges-*.sql

# terraform (infrastructure/)
# .terraform.lock.hcl is deliberately NOT here — it pins provider versions and
# belongs in the repo, the same way package-lock.json does.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# tfvars contain environment-specific values and may contain sensitive data.
# Commit example files instead.
*.tfvars
*.auto.tfvars
!*.tfvars.example

# python (services/agent-service)
# uv.lock is deliberately NOT here — it is the single source of truth for what
# the container installs, and the Dockerfile builds with --frozen against it.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# cloud credentials — never commit
service-account*.json
credentials*.json
*.pem
*.key